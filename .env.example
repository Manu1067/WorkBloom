# WorkBloom Environment Configuration Example

# API Base URL for Spring Boot proxy (defaults to /spring-api in development)
VITE_API_BASE_URL=/spring-api

# Map tiles for the Travel map (MapLibre GL JS). No API key required.
# Defaults to the OpenStreetMap standard tile server, which is intended for
# light/demo use only - https://operations.osmfoundation.org/policies/tiles/
# Point this at your own tile server or a commercial provider for production.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
