# WorkBloom backend — local environment variables
#
# Copy this file's values into REAL environment variables before running
# the backend locally. Spring Boot does NOT auto-load a .env file — this
# file is documentation of what's required, not something the app reads
# directly. See "How to set these locally" below.
#
# NEVER put real secrets in this file. Only placeholders belong here.
# The actual .env (if you create one for your own shell to source) must
# stay untracked — see backend/.gitignore.

DB_USERNAME=postgres
DB_PASSWORD=your_database_password
JWT_SECRET=your_long_random_secret

# ---------------------------------------------------------------------
# How to set these locally
# ---------------------------------------------------------------------
#
# Windows PowerShell (current session only):
#   $env:DB_USERNAME="postgres"
#   $env:DB_PASSWORD="your_database_password"
#   $env:JWT_SECRET="your_long_random_secret"
#   .\mvnw.cmd spring-boot:run
#
# Windows cmd.exe (current session only):
#   set DB_USERNAME=postgres
#   set DB_PASSWORD=your_database_password
#   set JWT_SECRET=your_long_random_secret
#   mvnw.cmd spring-boot:run
#
# macOS / Linux (current shell session only):
#   export DB_USERNAME=postgres
#   export DB_PASSWORD=your_database_password
#   export JWT_SECRET=your_long_random_secret
#   ./mvnw spring-boot:run
#
# JWT_SECRET should be a long, random string (32+ characters) — for
# example, generate one with:
#   openssl rand -base64 48